<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dialog"
    android:fillViewport="true"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="20dp"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/graph_settings"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/graph_settings_hint"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <TextView
            style="@style/Munhana.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/section_grid" />

        <CheckBox
            android:id="@+id/cbGrid"
            style="@style/Munhana.Setting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/opt_grid" />

        <CheckBox
            android:id="@+id/cbMinor"
            style="@style/Munhana.Setting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/opt_minor_grid" />

        <CheckBox
            android:id="@+id/cbNumbers"
            style="@style/Munhana.Setting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/opt_axis_numbers" />

        <CheckBox
            android:id="@+id/cbArrows"
            style="@style/Munhana.Setting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/opt_arrows" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/cbXAxis"
                style="@style/Munhana.Setting"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/opt_x_axis" />

            <CheckBox
                android:id="@+id/cbYAxis"
                style="@style/Munhana.Setting"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/opt_y_axis" />
        </LinearLayout>

        <TextView
            style="@style/Munhana.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/section_vars" />

        <CheckBox
            android:id="@+id/cbPrettyVars"
            style="@style/Munhana.Setting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/opt_pretty_vars" />

        <TextView
            style="@style/Munhana.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/section_window" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etXMin"
                style="@style/Munhana.Range"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="x min" />

            <EditText
                android:id="@+id/etXMax"
                style="@style/Munhana.Range"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:hint="x max" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etYMin"
                style="@style/Munhana.Range"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="y min" />

            <EditText
                android:id="@+id/etYMax"
                style="@style/Munhana.Range"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:hint="y max" />
        </LinearLayout>

        <Button
            android:id="@+id/btnApplyWindow"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_btn_tonal"
            android:text="@string/apply_window"
            android:textAllCaps="false"
            android:textColor="@color/purple_light"
            android:textSize="13sp" />

        <TextView
            style="@style/Munhana.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/section_units" />

        <RadioGroup
            android:id="@+id/rgUnits"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbRadians"
                style="@style/Munhana.Setting"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/radians" />

            <RadioButton
                android:id="@+id/rbDegrees"
                style="@style/Munhana.Setting"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/degrees" />
        </RadioGroup>

        <TextView
            style="@style/Munhana.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/section_display" />

        <CheckBox
            android:id="@+id/cbProjector"
            style="@style/Munhana.Setting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/opt_projector" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnDefaults"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_text"
                android:text="@string/reset_defaults"
                android:textAllCaps="false"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnDone"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_primary"
                android:text="@string/done"
                android:textAllCaps="false"
                android:textColor="#160B24"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
